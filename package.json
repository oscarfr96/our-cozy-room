{
  "name": "our-cozy-room",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "check:public": "node scripts/check-public.mjs",
    "setup:check": "node scripts/check-setup.mjs",
    "test": "vitest run",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:integration": "npm run build && wrangler deploy --dry-run --outdir .wrangler/test-bundle && node tests/worker.integration.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "jose": "6.2.13",
    "lucide-react": "1.61.0",
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "miniflare": "5.20261023.0-beta",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
